# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.
# 로컬 개발은 기본값(application-local.yml)으로 동작하므로 비워 둬도 된다.

# --- DB / 캐시 ---
DB_URL=jdbc:postgresql://localhost:5432/stockgraph
DB_USERNAME=stockgraph
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

